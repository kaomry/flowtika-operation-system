# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://flowtika:flowtika@localhost:5432/flowtika

# Telegram: create a bot with @BotFather, then message @userinfobot to get your numeric user id
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Model backend: "claude-code" runs the official Claude Code CLI signed in with your own
# Claude subscription (personal use). "api" uses the Claude API with ANTHROPIC_API_KEY.
MODEL_BACKEND=claude-code
ANTHROPIC_API_KEY=

# Model per tier. For claude-code these can be aliases (haiku, sonnet, opus).
MODEL_FAST=haiku
MODEL_STANDARD=sonnet
MODEL_DEEP=opus

# Path to the claude binary, if it isn't on PATH
CLAUDE_BIN=claude

# Voice notes, transcribed on this machine with whisper.cpp (free; audio never leaves the Mac).
# Leave WHISPER_MODEL empty to turn voice notes off.
WHISPER_BIN=whisper-cli
WHISPER_MODEL=
# "auto" detects Hebrew or English per note; "he" or "en" forces one
WHISPER_LANGUAGE=auto
FFMPEG_BIN=ffmpeg

# Gmail: an OAuth client of type "Desktop app" from Google Cloud (see README, Gmail).
# Then run `npm run google:connect` once to sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your own addresses, comma-separated, so mail between them isn't treated as outreach
OWNER_EMAILS=

# Notion: an internal integration's token, with the Leads page shared to it (see README)
NOTION_TOKEN=
NOTION_LEADS_DATA_SOURCE=c84cae23-1208-8343-973d-871608f38a92
# Cold email writer
OUTREACH_STYLE_GUIDE=~/.flowtika/data/cold-email-style-guide.md
OUTREACH_SIGNATURE="Omry Kaufman\nFounder & RevOps Strategic\n055-4222014"
# How often lead statuses in Notion are synced from Gmail; empty turns it off
OUTREACH_STATUS_SYNC_CRON=*/30 * * * *

# Scheduling
TIMEZONE=Asia/Jerusalem
# Cron for the morning check-in; leave empty to turn it off
DAILY_BRIEF_CRON=0 8 * * *

# How many past messages the Chief of Staff remembers per reply
MEMORY_MESSAGES=30

LOG_LEVEL=info
